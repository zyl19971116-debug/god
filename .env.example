# ── Database (Supabase / Postgres) ───────────────────────────────────────────
# When present the repository layer uses Supabase. When absent the app runs on
# an in-memory seeded store so the site is fully functional without a database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI provider (OpenAI-compatible /chat/completions) ────────────────────────
# Server-side only. Never prefixed with NEXT_PUBLIC_.
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ── Image generation (optional, OpenAI-compatible /images/generations) ───────
IMAGE_API_KEY=
IMAGE_API_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-1

# ── Web3 ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_DEFAULT_CHAIN_ID=1
